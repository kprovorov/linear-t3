{
  "pollIntervalSeconds": 60,
  "maxLaunchesPerPoll": 5,
  "fullScanIntervalMinutes": 60,
  "stateFile": "./state.json",
  "t3": {
    "url": "http://127.0.0.1:3773"
  },
  "projects": {
    "/home/me/projects/my-app": {
      "linear": {
        "team": "ENG",
        "filter": {
          "labels": { "some": { "name": { "eqIgnoreCase": "t3" } } },
          "state": { "type": { "in": ["unstarted"] } },
          "priority": { "lte": 2, "gt": 0 }
        },
        "onLaunch": { "comment": true, "moveToState": "In Progress" }
      },
      "workspace": { "type": "worktree", "baseRef": "main", "startFromOrigin": true },
      "runtimeMode": "full-access",
      "interactionMode": "default"
    },
    "infra": {
      "linear": {
        "team": "OPS",
        "filter": {
          "assignee": { "email": { "eq": "bot@example.com" } },
          "state": { "name": { "eq": "Ready for agent" } }
        },
        "onLaunch": { "moveToState": "Investigating" }
      },
      "workspace": { "type": "root" },
      "runtimeMode": "approval-required",
      "interactionMode": "plan",
      "model": { "instanceId": "claudeAgent", "model": "claude-opus-5-5" },
      "promptTemplate": "Investigate {identifier}: {title}\n\n{url}\n\n{description}\n\nWork on branch {branchName}."
    }
  }
}
