{
  "name": "linear-t3",
  "version": "0.1.0",
  "description": "Daemon that polls Linear issues and launches T3 Code threads for them",
  "keywords": [
    "automation",
    "cli",
    "daemon",
    "linear",
    "t3",
    "t3-code"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kprovorov/linear-t3.git"
  },
  "bin": {
    "linear-t3": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "vp pack",
    "prepack": "vp pack",
    "start": "node src/cli.ts run",
    "once": "node src/cli.ts run --once",
    "dry-run": "node src/cli.ts run --dry-run",
    "cli": "node src/cli.ts",
    "typecheck": "tsc",
    "check": "vp check",
    "test": "vp test"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@linear/sdk": "^97.1.0",
    "commander": "^15.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^5.9.3",
    "vite-plus": "1.1.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.11.2"
}
