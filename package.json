{
  "name": "linear-t3",
  "version": "0.1.0",
  "private": true,
  "description": "Daemon that polls Linear issues and launches T3 Code threads for them",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "once": "node --env-file-if-exists=.env src/main.ts --once",
    "dry-run": "node --env-file-if-exists=.env src/main.ts --once --dry-run",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@linear/sdk": "^97.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^5.9.3"
  }
}
