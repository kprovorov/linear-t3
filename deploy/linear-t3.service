# systemd user unit. Install:
#   cp deploy/linear-t3.service ~/.config/systemd/user/
#   (edit WorkingDirectory / node path below)
#   systemctl --user daemon-reload && systemctl --user enable --now linear-t3
#   loginctl enable-linger "$USER"   # keep running after logout
#   journalctl --user -u linear-t3 -f
[Unit]
Description=Linear -> T3 Code thread launcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/linear-t3
EnvironmentFile=%h/linear-t3/.env
ExecStart=/usr/bin/env node src/main.ts
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
